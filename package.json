{
  "name": "stream-queue",
  "author": "choompuy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/choompuy/stream-queue"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "tsx --test \"tests/**/*.test.ts\"",
    "test:frontend": "node --test \"tests/**/*.test.js\"",
    "test:smoke": "node scripts/smoke-frontend.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "build:sea": "node scripts/build-sea.mjs",
    "build:release": "node scripts/build-release.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.3",
    "express": "^5.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsdom": "^30.1.0",
    "postject": "^1.0.0-alpha.6",
    "rcedit": "^4.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "bin": "dist/server.js",
  "version": "0.2.2",
  "engines": {
    "node": ">=22"
  }
}
